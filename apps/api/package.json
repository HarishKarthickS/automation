{
  "name": "@automation/api",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "predev": "corepack pnpm --filter @automation/shared build",
    "dev": "tsx watch src/server.ts",
    "prebuild": "corepack pnpm --filter @automation/shared build",
    "build": "tsc -p tsconfig.json",
    "prestart": "corepack pnpm --filter @automation/shared build",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "corepack pnpm --filter @automation/shared build",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "secrets:rotate": "tsx src/scripts/rotateSecrets.ts"
  },
  "dependencies": {
    "@automation/shared": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "better-auth": "1.7.12",
    "cron-parser": "^5.10.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8",
    "vitest": "^5.0.5"
  }
}
